# TARIRO Studio v4 — Environment Variables
# Copy to .env and fill in your values

# ── LLM ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-free
OPENAI_API_BASE=http://litellm:4000/v1
LITELLM_MASTER_KEY=sk-free

# ── Services ──────────────────────────────────────────────
REDIS_HOST=redis
QDRANT_URL=http://qdrant:6333
SEARXNG_URL=http://searxng:8080

# ── GitHub integration ────────────────────────────────────
GITHUB_TOKEN=

# ── Workspace ─────────────────────────────────────────────
TARIRO_WORKSPACE=/app/workspace

# ── Runtime ───────────────────────────────────────────────
PYTHONUNBUFFERED=1
LOG_LEVEL=INFO
