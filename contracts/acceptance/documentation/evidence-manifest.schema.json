{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zipporah documentation acceptance evidence manifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_revision": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "fixture_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "profile": {
      "enum": [
        "smoke_one",
        "reference_thirty"
      ]
    },
    "environment_class": {
      "enum": [
        "reference_model",
        "sandbox_adapter",
        "live_provider"
      ]
    },
    "operator_ref": {
      "type": "string",
      "minLength": 1
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "case_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ZIP-DOC-E2E-T[0-9]{2}$"
          },
          "verdict": {
            "enum": [
              "passed",
              "failed",
              "blocked",
              "skipped",
              "unavailable"
            ]
          },
          "observed_outcome": {
            "type": "string",
            "minLength": 1
          },
          "receipt_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "evidence_digests": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "observations": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": [
                "string",
                "integer",
                "boolean"
              ]
            }
          }
        },
        "required": [
          "id",
          "verdict"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "verdict": {
                  "enum": [
                    "passed",
                    "failed"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "observed_outcome",
                "receipt_digest",
                "evidence_digests",
                "observations"
              ]
            },
            "else": {
              "required": [
                "reason"
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "contract_revision",
    "fixture_digest",
    "profile",
    "environment_class",
    "operator_ref",
    "policy_digest",
    "case_results"
  ],
  "additionalProperties": false
}
