{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zipporah first-party crate dependency graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_version", "source_revision", "components"],
  "properties": {
    "schema": { "const": "../schemas/dependency-graph.schema.json" },
    "contract_version": { "const": 1 },
    "source_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "design", "dependencies"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "design": { "type": "string", "pattern": "^crates/[a-z][a-z0-9-]*/DESIGN\\.md$" },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dependency" }
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "optional", "feature", "target"],
      "properties": {
        "component": { "$ref": "#/$defs/identifier" },
        "optional": { "type": "boolean" },
        "feature": { "type": ["string", "null"], "minLength": 1 },
        "target": { "type": ["string", "null"], "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "optional": { "const": true } } },
          "then": { "properties": { "feature": { "type": "string" } } },
          "else": { "properties": { "feature": { "type": "null" } } }
        }
      ]
    }
  }
}
