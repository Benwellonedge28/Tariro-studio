{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zipporah profile manifest v1",
  "type": "object",
  "required": ["schema_version", "profile", "preferences"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "preferences": {
      "type": "object",
      "required": ["concurrency", "inference", "locality"],
      "additionalProperties": false,
      "properties": {
        "concurrency": {"enum": ["serial", "admission_controlled"]},
        "inference": {"enum": ["deterministic_first", "small_model_first", "best_fit", "policy_selected"]},
        "locality": {"enum": ["local_only", "approved_nodes", "policy_selected"]}
      }
    },
    "limits": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
        "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
      }
    },
    "derive_from_admission": {
      "type": "object",
      "required": ["keys"],
      "additionalProperties": false,
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["inference.max_loaded_generation_models", "orchestration.max_concurrent_agents"]
          }
        }
      }
    }
  }
}
